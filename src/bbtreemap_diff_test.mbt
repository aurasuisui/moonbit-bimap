// Differential tests for BiBTreeMap against the REAL Rust `bimap` crate
// v0.6.3 BiBTreeMap (RELEASE_CHECKLIST Tier 1). The expected observations
// come from `bbtreemap_diff_fixture_test.mbt`, generated by `tools/diffgen`
// running the reference crate over the SAME streams used here:
//   - the golden C0-C4 sequence (shared with bbtreemap_test.mbt),
//   - the 6000-step deterministic LCG op stream (5 ops incl. retain with the
//     shared deterministic predicate — same stream as the BiMap side).
//
// Stronger than the BiMap differential: the final check compares the FULL
// sorted pair list (iteration order) against the reference terminal state,
// not just pair-set membership — the "sorted terminal state" check from the
// v0.2.0 plan §3.
//
// Scope: only the PORTED semantics are diffed (insert / insert_no_overwrite /
// remove_by_left / remove_by_right / retain as observable Overwritten /
// Option / Result values plus len, and the final sorted iteration order).
// range/left_keys/right_values/first/last/get_or_insert_* are this library's
// own surface (range wraps core SortedMap::range with inclusive bounds —
// pinned by bbtreemap_test.mbt), and stay out of the differential.

// ---------------------------------------------------------------------------
// Observation encoding (must match tools/diffgen exactly)
// ---------------------------------------------------------------------------

///|
/// Run an `insert` and encode its `Overwritten` result plus the resulting
/// len into the fixture's string format.
fn bbtree_diff_encode_insert(
  m : @aurasuisui/bimap.BiBTreeMap[Int, Int],
  l : Int,
  r : Int,
) -> String {
  let obs = match m.insert(l, r) {
    @aurasuisui/bimap.Neither => "Neither"
    @aurasuisui/bimap.Left(l0, r0) => "Left(\{l0},\{r0})"
    @aurasuisui/bimap.Right(l0, r0) => "Right(\{l0},\{r0})"
    @aurasuisui/bimap.Both((l1, r1), (l2, r2)) =>
      "Both((\{l1},\{r1}),(\{l2},\{r2}))"
    @aurasuisui/bimap.Pair(l0, r0) => "Pair(\{l0},\{r0})"
  }
  "\{obs}|\{m.len()}"
}

///|
/// Replay the full 6000-step LCG stream (same derivation as model_test.mbt /
/// differential_test.mbt, five ops including retain with the shared
/// deterministic predicate) and return the resulting map.
fn bbtree_diff_run_full_stream() -> @aurasuisui/bimap.BiBTreeMap[Int, Int] {
  let m : @aurasuisui/bimap.BiBTreeMap[Int, Int] = @aurasuisui/bimap.BiBTreeMap::new()
  let mut state = 0x1234_5678
  let mut i = 0
  while i < 6000 {
    state = (state * 1103515245 + 12345) & 0x7FFF_FFFF
    let op = state % 5
    let l = (state >> 6) % 15
    let r = (state >> 14) % 15
    if op == 0 {
      m.insert(l, r) |> ignore
    } else if op == 1 {
      m.remove_by_left(l) |> ignore
    } else if op == 2 {
      m.remove_by_right(r) |> ignore
    } else if op == 3 {
      m.insert_no_overwrite(l, r) |> ignore
    } else {
      m.retain(fn(l : Int, r : Int) -> Bool { (l + r) % 3 != 0 })
    }
    i = i + 1
  }
  m
}

// ---------------------------------------------------------------------------
// The differential tests
// ---------------------------------------------------------------------------

///|
test "bbtree diff vs Rust BiBTreeMap: golden C0-C4 sequence matches" {
  let m : @aurasuisui/bimap.BiBTreeMap[Int, Int] = @aurasuisui/bimap.BiBTreeMap::new()
  let golden = [(1, 10), (2, 20), (1, 40), (3, 20), (1, 20), (1, 20)]
  let mut i = 0
  while i < golden.length() {
    let (l, r) = golden[i]
    let actual = bbtree_diff_encode_insert(m, l, r)
    if actual != bbtree_diff_golden_observations[i] {
      @test.fail(
        "golden step \{i}: expected \{bbtree_diff_golden_observations[i]}, got \{actual}",
      )
    }
    i = i + 1
  }
}

///|
test "bbtree diff vs Rust BiBTreeMap: 6000 mixed ops agree step by step" {
  let m : @aurasuisui/bimap.BiBTreeMap[Int, Int] = @aurasuisui/bimap.BiBTreeMap::new()
  let mut state = 0x1234_5678
  let mut i = 0
  while i < 6000 {
    state = (state * 1103515245 + 12345) & 0x7FFF_FFFF
    let op = state % 5
    let l = (state >> 6) % 15
    let r = (state >> 14) % 15
    let actual = if op == 0 {
      bbtree_diff_encode_insert(m, l, r)
    } else if op == 1 {
      match m.remove_by_left(l) {
        Some(v) => "Some(\{v})|\{m.len()}"
        None => "None|\{m.len()}"
      }
    } else if op == 2 {
      match m.remove_by_right(r) {
        Some(v) => "Some(\{v})|\{m.len()}"
        None => "None|\{m.len()}"
      }
    } else if op == 3 {
      match m.insert_no_overwrite(l, r) {
        Ok(_) => "Ok|\{m.len()}"
        Err(_) => "Err|\{m.len()}"
      }
    } else {
      m.retain(fn(l : Int, r : Int) -> Bool { (l + r) % 3 != 0 })
      "Retain|\{m.len()}"
    }
    if actual != bbtree_diff_observations[i] {
      @test.fail(
        "step \{i} (op=\{op}, l=\{l}, r=\{r}): expected \{bbtree_diff_observations[i]}, got \{actual}",
      )
    }
    i = i + 1
  }
}

///|
test "bbtree diff vs Rust BiBTreeMap: sorted terminal state matches EXACTLY" {
  // Stronger than the BiMap side's membership check: the full ascending pair
  // sequence must equal the reference terminal state, ORDER INCLUDED.
  let m = bbtree_diff_run_full_stream()
  @test.assert_eq(m.into_array(), bbtree_diff_final_pairs)
  @test.assert_eq(m.len(), bbtree_diff_final_pairs.length())
}
