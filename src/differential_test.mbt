// Differential tests against the REAL Rust `bimap` crate v0.6.3 (RELEASE_
// CHECKLIST Tier 1). The expected observations come from
// `differential_fixture_test.mbt`, generated by `tools/diffgen` running the
// reference crate over the SAME streams used here:
//   - the golden C0-C4 sequence (shared with bimap_test.mbt / model_test.mbt),
//   - the 6000-step deterministic LCG op stream (shared with model_test.mbt).
//
// Unlike model_test.mbt's oracle — which models THIS library's documented
// semantics (it could share a misreading of the spec with the implementation)
// — the fixture is produced by the original implementation itself, so
// agreement here validates the port against its source of truth.
//
// Scope: only the PORTED semantics are diffed (insert / insert_no_overwrite /
// remove_by_left / remove_by_right, as observable Overwritten / Option /
// Result values plus len). Insertion-order preservation and index access are
// this library's original extensions — Rust bimap has neither — so they stay
// covered by model_test.mbt's oracle.
//
// Note: Rust bimap's remove_by_left/right returns the whole removed (L, R)
// pair; this library's `remove_by_left(l) -> R?` / `remove_by_right(r) -> L?`
// is informationally equivalent (the caller already supplies the other side).
// The fixture encodes the observable side only, so the encodings line up.

// ---------------------------------------------------------------------------
// Observation encoding (must match tools/diffgen exactly)
// ---------------------------------------------------------------------------

///|
/// Run an `insert` and encode its `Overwritten` result plus the resulting len
/// into the fixture's string format.
fn diff_encode_insert(
  m : @aurasuisui/bimap.BiMap[Int, Int],
  l : Int,
  r : Int,
) -> String {
  let obs = match m.insert(l, r) {
    @aurasuisui/bimap.Neither => "Neither"
    @aurasuisui/bimap.Left(l0, r0) => "Left(\{l0},\{r0})"
    @aurasuisui/bimap.Right(l0, r0) => "Right(\{l0},\{r0})"
    @aurasuisui/bimap.Both((l1, r1), (l2, r2)) =>
      "Both((\{l1},\{r1}),(\{l2},\{r2}))"
    @aurasuisui/bimap.Pair(l0, r0) => "Pair(\{l0},\{r0})"
  }
  "\{obs}|\{m.len()}"
}

///|
/// Replay the full 6000-step LCG stream (same derivation as model_test.mbt)
/// and return the resulting map.
fn diff_run_full_stream() -> @aurasuisui/bimap.BiMap[Int, Int] {
  let m : @aurasuisui/bimap.BiMap[Int, Int] = @aurasuisui/bimap.new()
  let mut state = 0x1234_5678
  let mut i = 0
  while i < 6000 {
    state = (state * 1103515245 + 12345) & 0x7FFF_FFFF
    let op = state % 4
    let l = (state >> 6) % 15
    let r = (state >> 14) % 15
    if op == 0 {
      m.insert(l, r) |> ignore
    } else if op == 1 {
      m.remove_by_left(l) |> ignore
    } else if op == 2 {
      m.remove_by_right(r) |> ignore
    } else {
      m.insert_no_overwrite(l, r) |> ignore
    }
    i = i + 1
  }
  m
}

// ---------------------------------------------------------------------------
// The differential tests
// ---------------------------------------------------------------------------

///|
test "diff vs Rust bimap: golden C0-C4 sequence matches the reference crate" {
  let m : @aurasuisui/bimap.BiMap[Int, Int] = @aurasuisui/bimap.new()
  let golden = [(1, 10), (2, 20), (1, 40), (3, 20), (1, 20), (1, 20)]
  let mut i = 0
  while i < golden.length() {
    let (l, r) = golden[i]
    let actual = diff_encode_insert(m, l, r)
    if actual != diff_golden_observations[i] {
      @test.fail(
        "golden step \{i}: expected \{diff_golden_observations[i]}, got \{actual}",
      )
    }
    i = i + 1
  }
}

///|
test "diff vs Rust bimap: 6000 deterministic mixed ops agree step by step" {
  let m : @aurasuisui/bimap.BiMap[Int, Int] = @aurasuisui/bimap.new()
  let mut state = 0x1234_5678
  let mut i = 0
  while i < 6000 {
    state = (state * 1103515245 + 12345) & 0x7FFF_FFFF
    let op = state % 4
    let l = (state >> 6) % 15
    let r = (state >> 14) % 15
    let actual = if op == 0 {
      diff_encode_insert(m, l, r)
    } else if op == 1 {
      match m.remove_by_left(l) {
        Some(v) => "Some(\{v})|\{m.len()}"
        None => "None|\{m.len()}"
      }
    } else if op == 2 {
      match m.remove_by_right(r) {
        Some(v) => "Some(\{v})|\{m.len()}"
        None => "None|\{m.len()}"
      }
    } else {
      match m.insert_no_overwrite(l, r) {
        Ok(_) => "Ok|\{m.len()}"
        Err(_) => "Err|\{m.len()}"
      }
    }
    if actual != diff_observations[i] {
      @test.fail(
        "step \{i} (op=\{op}, l=\{l}, r=\{r}): expected \{diff_observations[i]}, got \{actual}",
      )
    }
    i = i + 1
  }
}

///|
test "diff vs Rust bimap: final map content matches the reference pair set" {
  let m = diff_run_full_stream()
  @test.assert_eq(m.len(), diff_final_pairs.length())
  let mut j = 0
  while j < diff_final_pairs.length() {
    let (l, r) = diff_final_pairs[j]
    @test.assert_eq(m.get_by_left(l), Some(r))
    j = j + 1
  }
}
